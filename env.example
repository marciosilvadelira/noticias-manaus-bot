# Copie este arquivo para ".env" SOMENTE se for rodar no seu computador.
# No GitHub, estes valores são cadastrados em Settings > Secrets and variables > Actions.
# NUNCA envie o arquivo .env para o GitHub (ele já está no .gitignore).

# ---------- Segurança ----------
# true = modo de simulação (nada vai ao Facebook). Só mude para false após os testes.
DRY_RUN=true
# true = pausa total (não lê nem publica)
PAUSED=false

# ---------- Fonte ----------
# Vazio = RSS geral do portal (https://marioadolfo.com/latest/rss/).
# Para somar feeds de seções, separe por vírgula:
# FEED_URLS=https://marioadolfo.com/latest/rss/,https://marioadolfo.com/policia/rss/
FEED_URLS=
# Vazio = todas as seções. Exemplo: CATEGORIES=Amazonas,Parintins
CATEGORIES=
# Nunca publicar matérias mais antigas que isso (em horas)
MAX_AGE_HOURS=24

# ---------- Limites ----------
MAX_POSTS_PER_RUN=5
MAX_POSTS_PER_DAY=20
MAX_ATTEMPTS=3
POST_INTERVAL_SECONDS=20
TIMEZONE=America/Manaus

# ---------- Formato ----------
# link   = Formato A (título, linha fina, crédito e link)
# resumo = Formato B (resumo por IA; sem IA configurada, usa o Formato A)
POST_FORMAT=link
# true = publica a mesma notícia nos DOIS formatos (não recomendado)
ALLOW_BOTH_FORMATS=false
# preview = cartão do link com a imagem da matéria (recomendado)
# photo   = publica a imagem destacada como foto, com o texto e o link na legenda
IMAGE_MODE=preview

# ---------- Meta / Facebook ----------
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Opcionais: permitem ver validade e permissões do token (python main.py check-token)
FB_APP_ID=
FB_APP_SECRET=
GRAPH_API_VERSION=v26.0

# ---------- IA (opcional, para o Formato B) ----------
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# ---------- Armazenamento ----------
STATE_FILE=data/historico.json
HISTORY_RETENTION_DAYS=60
